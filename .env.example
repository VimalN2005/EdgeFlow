# EdgeFlow Configuration
APP_NAME=EdgeFlow
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Redis connection
# Provide a valid Redis URI or leave default to auto-fallback to in-memory fake redis
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=2.0

# Security & Authentication
API_KEY_HEADER=X-API-Key
GATEWAY_SECRET_KEY=edgeflow-super-secret-key-change-in-production

# Default Rate Limits (Requests per minute per tier)
RATE_LIMIT_FREE=30
RATE_LIMIT_PRO=120
RATE_LIMIT_ENTERPRISE=600

# Response Cache
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=60

# Upstream & Resilience Defaults
DEFAULT_CONNECT_TIMEOUT=3.0
DEFAULT_READ_TIMEOUT=15.0
DEFAULT_MAX_RETRIES=2
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIME=15.0
